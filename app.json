{
  "expo": {
    "name": "Celebrity's Chat",
    "slug": "celebritys-chat",
    "scheme": "celebrityschat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.allconnect.celebritychat"
    },
    "android": {
      "package": "com.allconnect.celebritychat",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
